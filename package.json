{
  "name": "trayport-web",
  "version": "1.0.0",
  "description": "Self-hosted Next.js and Payload proof of concept for the Trayport website",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env MEDIA_STORAGE_MODE=build NODE_OPTIONS=--no-deprecation next build",
    "content:extract": "cross-env TMPDIR=/tmp tsx migration/cli.ts extract --scope pilot",
    "content:inventory": "cross-env TMPDIR=/tmp tsx migration/cli.ts inventory --scope production",
    "content:load": "cross-env TMPDIR=/tmp tsx migration/cli.ts load --publish",
    "content:preflight": "cross-env TMPDIR=/tmp tsx migration/cli.ts preflight",
    "content:recover-media": "cross-env TMPDIR=/tmp tsx migration/cli.ts recover-media",
    "content:transform": "cross-env TMPDIR=/tmp tsx migration/cli.ts transform",
    "content:validate": "cross-env TMPDIR=/tmp tsx migration/cli.ts validate",
    "postbuild": "node scripts/check-public-shell-budget.mjs && node scripts/check-public-route-budgets.mjs && next-sitemap --config next-sitemap.config.cjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && corepack pnpm build && corepack pnpm start",
    "deploy:migrate": "node scripts/run-migrations.mjs",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation corepack pnpm --ignore-workspace install",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && corepack pnpm --ignore-workspace install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation node scripts/start-standalone.mjs",
    "tailwind:check": "node scripts/check-tailwind-canonical.mjs",
    "test": "corepack pnpm run test:int && corepack pnpm run test:ui && corepack pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:gallery": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.gallery.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "test:ui": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.ui.config.mts",
    "test:visual": "cross-env PLAYWRIGHT_SKIP_WEBSERVER=true NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.visual.config.ts",
    "test:visual:dev": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.visual.config.ts",
    "visual:update-reference": "cross-env PLAYWRIGHT_BASE_URL=http://trayport.local PLAYWRIGHT_SKIP_WEBSERVER=true NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.visual.config.ts --update-snapshots",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@awesome.me/kit-9e17af3472": "1.0.10",
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@fortawesome/react-fontawesome": "3.5.0",
    "@payloadcms/admin-bar": "3.86.0",
    "@payloadcms/db-postgres": "3.86.0",
    "@payloadcms/email-nodemailer": "3.86.0",
    "@payloadcms/live-preview-react": "3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/plugin-redirects": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/storage-s3": "3.86.0",
    "@payloadcms/ui": "3.86.0",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cross-env": "^7.0.3",
    "csv-parse": "6.1.0",
    "dotenv": "16.4.7",
    "exceljs": "4.4.0",
    "graphql": "^16.8.2",
    "highcharts": "12.2.0",
    "mapbox-gl": "3.11.1",
    "next": "16.2.6",
    "next-sitemap": "^4.2.3",
    "payload": "3.86.0",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.34.2",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "1.58.2",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@testing-library/react": "16.3.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "22.19.9",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.6",
    "jsdom": "28.0.0",
    "postcss": "^8.4.38",
    "prettier": "^3.4.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=22 <23",
    "pnpm": "^9 || ^10 || ^11"
  },
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
