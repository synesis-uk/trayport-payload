# Application
# Exact public HTTP(S) origin only: no path, query string, fragment, or credentials.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
PAYLOAD_SECRET=replace-with-a-long-random-value
PAYLOAD_COOKIE_SECURE=false
CRON_SECRET=replace-with-a-long-random-value
PREVIEW_SECRET=replace-with-a-long-random-value
# The internal component gallery returns 404 unless this is exactly `true`.
DESIGN_SYSTEM_ENABLED=false

# Browser-visible Mapbox configuration. Leave the token blank to retain the
# deterministic static/SVG fallback. Use approved deployment-owned styles.
MAPBOX_PUBLIC_TOKEN=
MAPBOX_STYLE_DARK_URL=mapbox://styles/synesis/cm5a5svbz001201sc9h355wja
MAPBOX_STYLE_LIGHT_URL=mapbox://styles/synesis/cm7nf3tgh000f01sc67zobky8
# Temporary compatibility fallback for deployments that have not split styles.
MAPBOX_STYLE_URL=

# Payload PostgreSQL database
POSTGRES_DB=trayport_payload
POSTGRES_USER=trayport
POSTGRES_PASSWORD=trayport
POSTGRES_PORT=5432
DATABASE_URL=postgresql://trayport:trayport@127.0.0.1:5432/trayport_payload

# Use committed migrations so Payload never treats application-owned tables as
# disposable development schema.
PAYLOAD_DB_PUSH=false

# MinIO / S3-compatible media storage
# Local development uses the durable MinIO service through the same S3 adapter as production.
# Other explicit modes are `local-development`, `local-persistent`, and build-only `build`.
MEDIA_STORAGE_MODE=s3
# `local-persistent` requires an absolute mounted directory, for example:
# MEDIA_STORAGE_LOCAL_PATH=/var/lib/trayport/media
MINIO_ROOT_USER=trayport
MINIO_ROOT_PASSWORD=trayport-minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=eu-west-2
S3_BUCKET=trayport-media
S3_ACCESS_KEY_ID=trayport
S3_SECRET_ACCESS_KEY=trayport-minio
S3_FORCE_PATH_STYLE=true

# Mailpit / SMTP
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM_ADDRESS=no-reply@trayport.local
SMTP_FROM_NAME=Trayport Website
# `next dev` runs Payload's scheduled-job worker by default. Set this to true on
# exactly one ECS worker task, or false on web-only/local processes.
PAYLOAD_JOBS_AUTORUN=true
# Delivery events remain eligible for this many hours after their exact instant.
BANNER_NOTIFICATION_CATCH_UP_HOURS=6
# Failed or abandoned delivery leases retry on later sweeps, up to this limit.
BANNER_NOTIFICATION_MAX_ATTEMPTS=3
# Wait before retrying a recorded SMTP failure.
BANNER_NOTIFICATION_RETRY_DELAY_MINUTES=5
# A worker lease can be recovered after this interval if its process disappears.
BANNER_NOTIFICATION_STALE_CLAIM_MINUTES=30

# Local WordPress source used by the PoC importer
WP_SOURCE_CONTAINER=trayport_local_site
WP_SOURCE_ROOT=/var/www/html
WP_SOURCE_SITE_URL=http://trayport.local
WP_SOURCE_UPLOADS=/home/admin/site/tp/web/app/uploads
MIGRATION_WORK_DIR=./migration/work

# Comma-separated hosts allowed to load development assets cross-origin. The LAN review
# server needs its own address here or client islands never hydrate. Development only.
DEV_ALLOWED_ORIGINS=
