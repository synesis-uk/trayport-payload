# Application
# Exact public HTTP(S) origin only: no path, query string, fragment, or credentials.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
PAYLOAD_SECRET=replace-with-a-long-random-value
PAYLOAD_COOKIE_SECURE=false
CRON_SECRET=replace-with-a-long-random-value
PREVIEW_SECRET=replace-with-a-long-random-value
# The internal component gallery returns 404 unless this is exactly `true`.
DESIGN_SYSTEM_ENABLED=false

# Browser-visible Mapbox configuration for the Home connections map. Leave
# either value blank to retain the deterministic static/SVG fallback.
MAPBOX_PUBLIC_TOKEN=
MAPBOX_STYLE_URL=mapbox://styles/synesis/cm5a5svbz001201sc9h355wja

# Payload PostgreSQL database
POSTGRES_DB=trayport_payload
POSTGRES_USER=trayport
POSTGRES_PASSWORD=trayport
POSTGRES_PORT=5432
DATABASE_URL=postgresql://trayport:trayport@127.0.0.1:5432/trayport_payload

# Use committed migrations so Payload never treats application-owned tables as
# disposable development schema.
PAYLOAD_DB_PUSH=false

# MinIO / S3-compatible media storage
# Local development uses the durable MinIO service through the same S3 adapter as production.
# Other explicit modes are `local-development`, `local-persistent`, and build-only `build`.
MEDIA_STORAGE_MODE=s3
# `local-persistent` requires an absolute mounted directory, for example:
# MEDIA_STORAGE_LOCAL_PATH=/var/lib/trayport/media
MINIO_ROOT_USER=trayport
MINIO_ROOT_PASSWORD=trayport-minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=eu-west-2
S3_BUCKET=trayport-media
S3_ACCESS_KEY_ID=trayport
S3_SECRET_ACCESS_KEY=trayport-minio
S3_FORCE_PATH_STYLE=true

# Mailpit / SMTP
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM_ADDRESS=no-reply@trayport.local
SMTP_FROM_NAME=Trayport Website

# Local WordPress source used by the PoC importer
WP_SOURCE_CONTAINER=trayport_local_site
WP_SOURCE_ROOT=/var/www/html
WP_SOURCE_SITE_URL=http://trayport.local
WP_SOURCE_UPLOADS=/home/admin/site/tp/web/app/uploads
MIGRATION_WORK_DIR=./migration/work
